{
  "name": "@hrms/db",
  "version": "0.0.0",
  "private": true,
  "description": "HRMS db package — skeleton, fleshed out in later phases",
  "license": "UNLICENSED",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings 0",
    "type": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:doctor": "tsx src/doctor.ts",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@hrms/config": "workspace:*",
    "@testcontainers/postgresql": "10.13.2",
    "@types/pg": "8.11.10",
    "drizzle-kit": "0.28.0",
    "testcontainers": "10.13.2",
    "tsx": "4.19.1",
    "typescript": "5.6.2",
    "vitest": "2.1.3"
  },
  "dependencies": {
    "drizzle-orm": "0.36.0",
    "pg": "8.13.0",
    "zod": "3.23.8"
  }
}
