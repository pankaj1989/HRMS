{
  "name": "hrms",
  "version": "0.0.0",
  "private": true,
  "description": "HRMS — Indian compliance-first multi-tenant HR platform",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=9.12.0"
  },
  "packageManager": "pnpm@9.12.0",
  "prettier": "@hrms/config/prettier/index.cjs",
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .prettierignore",
    "type": "turbo run type",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean && rm -rf node_modules",
    "bootstrap": "bash scripts/setup.sh",
    "verify": "bash scripts/verify-setup.sh",
    "dev:reset": "bash scripts/dev-reset.sh",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down",
    "docker:logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "db:migrate": "pnpm --filter @hrms/db db:migrate",
    "db:doctor": "pnpm --filter @hrms/db db:doctor",
    "db:generate": "pnpm --filter @hrms/db db:generate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "19.5.0",
    "@commitlint/config-conventional": "19.5.0",
    "@eslint/js": "9.12.0",
    "@hrms/config": "workspace:*",
    "eslint": "9.12.0",
    "husky": "9.1.6",
    "lint-staged": "15.2.10",
    "prettier": "3.3.3",
    "turbo": "2.1.3",
    "typescript": "5.6.2",
    "typescript-eslint": "8.8.0"
  },
  "pnpm": {
    "overrides": {
      "@eslint/plugin-kit": "^0.3.4",
      "ajv@^8.0.0": "^8.18.0",
      "cookie": "^0.7.0",
      "esbuild": "^0.25.0",
      "glob": "^10.5.0",
      "path-to-regexp": "^0.1.13",
      "picomatch": "^4.0.4",
      "postcss": "^8.5.10",
      "qs": "^6.14.2",
      "tar-fs": "^2.1.4",
      "tmp": "^0.2.4",
      "undici": "^6.24.0",
      "webpack": "^5.104.1",
      "yaml": "^2.8.3"
    }
  }
}
