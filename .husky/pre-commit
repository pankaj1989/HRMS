#!/usr/bin/env sh
# Run lint-staged (format + lint changed files)
pnpm exec lint-staged

# Block commits with secrets — gitleaks must be installed locally
if command -v gitleaks > /dev/null 2>&1; then
  gitleaks protect --staged --redact --config=.gitleaks.toml || {
    echo "✗ gitleaks found secrets in staged changes. Aborting commit."
    exit 1
  }
else
  echo "⚠ gitleaks not installed locally; skipping secret scan."
  echo "  Install: brew install gitleaks  (macOS)  |  https://github.com/gitleaks/gitleaks (other)"
fi
